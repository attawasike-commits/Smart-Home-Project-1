power_level = 100
max_power = 100

print("=== SMART LIGHTING CONTROL SYSTEM INITIALIZED ===")

while True:
    print("\n" + "=" * 40)

    # 1. Power Status
    print(f"Battery Level: {power_level}%")

    if power_level > 50:
        print("Power Status: Normal")
    elif power_level >= 20:
        print("Power Status: Low")
    else:
        print("Power Status: Critical - Recharge Needed")

    # 2. Motion Detection
    motion = input("\nMotion detected? (yes/no): ").lower()

    if motion == "yes":
        print("Motion detected")
        lights_on = True
    else:
        print("No motion detected")
        lights_on = False

    # 3. Ambient Light Sensor
    ambient_light = int(input("Ambient light level (0-100): "))

    if ambient_light < 30:
        brightness = 100
        print("Dark environment")
    elif ambient_light < 70:
        brightness = 60
        print("Moderately lit environment")
    else:
        brightness = 20
        print("Bright environment")

    # 4. Time-Based Control
    hour = int(input("Current hour (0-23): "))

    if 18 <= hour <= 23 or 0 <= hour <= 5:
        print("Night Mode Activated")
        brightness += 20
        if brightness > 100:
            brightness = 100
